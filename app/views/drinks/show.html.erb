<% content_for :title, @drink.name %>

<div class="mx-auto md:w-2/3 w-full bg-lagoon-800 p-5 rounded-lg">
  <% if notice.present? %>
    <p class="flash-notice mb-5" id="notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash-alert mb-5" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-accent text-4xl"><%= @drink.name %></h1>
  <% if @drink.published? %>
    <p class="mt-2 text-muted">Published: <%= link_to "see the public ranking", ranking_path(@drink), class: "underline" %></p>
  <% end %>

  <div><%= render @drink %>

  <section class="my-5">
    <h2 class="font-bold text-2xl text-accent">Recipes</h2>
    <ul id="recipes" class="list-disc ml-6 my-2">
      <% @drink.recipes.sort_by(&:title).each do |recipe| %>
        <li><%= link_to recipe.title, recipe, class: "underline" %></li>
      <% end %>
    </ul>
    <%= link_to "Add a recipe", new_recipe_path(drink_id: @drink), class: "button-secondary" %>
  </section>

  <section class="my-5">
    <h2 class="font-bold text-2xl text-accent">Every time we've had it</h2>
    <div class="divide-y divide-line">
      <% @drink.tastings.sort_by { |tasting| tasting.occasion.occurred_on }.reverse_each do |tasting| %>
        <%= render tasting, heading: link_to(tasting.occasion.title, tasting.occasion) %>
      <% end %>
    </div>
    <% if @drink.tastings.empty? %>
      <p class="my-5">Not tried yet.</p>
    <% end %>
  </section>

  <%= link_to "Edit this drink", edit_drink_path(@drink), class: "button-primary" %>
  <%= link_to "Back to drinks", drinks_path, class: "button-secondary" %>
  <%= button_to "Destroy this drink", @drink, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "button-tertiary", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
