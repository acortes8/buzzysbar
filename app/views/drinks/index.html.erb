<% content_for :title, "Drinks" %>

<div class="space-y-7">
  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Drinks</h1>
      <p class="mt-1 text-muted">Everything we've had, or want to.</p>
    </div>
    <div class="actions">
      <%= link_to "New drink", new_drink_path, class: "button-secondary" %>
    </div>
  </div>

  <% if @drinks.any? %>
    <ul id="drinks" class="card divide-y divide-line p-0">
      <%= render @drinks %>
    </ul>
  <% else %>
    <p class="card text-center text-muted">No drinks yet. Logging one adds it here.</p>
  <% end %>
</div>
