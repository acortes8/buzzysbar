<%= form_with(model: drink, class: "contents") do |form| %>
  <% if drink.errors.any? %>
    <div id="error_explanation" class="error-explanation">
      <h2><%= pluralize(drink.errors.count, "error") %> prohibited this drink from being saved:</h2>

      <ul class="list-disc ml-6">
        <% drink.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": drink.errors[:name].none?, "border-red-400 focus:outline-red-600": drink.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 3, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": drink.errors[:description].none?, "border-red-400 focus:outline-red-600": drink.errors[:description].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "button-primary" %>
  </div>
<% end %>
