<%= form_with(model: drink, class: "contents") do |form| %>
  <% if drink.errors.any? %>
    <div id="error_explanation" class="error-explanation">
      <h2><%= pluralize(drink.errors.count, "error") %> prohibited this drink from being saved:</h2>

      <ul class="list-disc ml-6">
        <% drink.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: input_class(drink, :name) %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 3, class: input_class(drink, :description) %>
  </div>

  <% unless demo? %>
    <div class="my-5 flex items-center gap-2">
      <%= form.check_box :published %>
      <%= form.label :published, "Publish a public ranking of this drink (shows places, months and average scores, never names or notes)" %>
    </div>
  <% end %>

  <div class="inline">
    <%= form.submit class: "button-primary" %>
  </div>
<% end %>
