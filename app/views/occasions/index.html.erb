<% content_for :title, "Occasions" %>

<div class="space-y-7">
  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Occasions</h1>
      <p class="mt-1 text-muted">Every night out and in, newest first.</p>
    </div>
    <div class="actions">
      <%= link_to "New occasion", new_occasion_path, class: "button-secondary" %>
    </div>
  </div>

  <div id="occasions" class="space-y-5">
    <% if @occasions.any? %>
      <%= render @occasions %>
    <% else %>
      <div class="card text-center">
        <p class="text-muted">No occasions yet.</p>
        <div class="actions mt-4 justify-center">
          <%= link_to "Log your first drink", new_log_path, class: "button-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
