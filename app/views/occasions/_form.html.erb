<%= form_with(model: occasion, class: "contents") do |form| %>
  <% if occasion.errors.any? %>
    <div id="error_explanation" class="error-explanation">
      <h2><%= pluralize(occasion.errors.count, "error") %> prohibited this occasion from being saved:</h2>

      <ul class="list-disc ml-6">
        <% occasion.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :place_name, "Place", class: "field-label" %>
    <%= form.text_field :place_name, list: "place-names", autocomplete: "off", placeholder: "Bar name, or Home", class: input_class(occasion, :place) %>
    <datalist id="place-names">
      <% Current.logbook.places.order(:name).pluck(:name).each do |name| %>
        <option value="<%= name %>"></option>
      <% end %>
    </datalist>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted">
      <span class="mr-1">A new name adds the place, as a</span>
      <% Place.kinds.each_key do |kind| %>
        <%= form.label "place_kind_#{kind}", class: "chip min-h-9 px-3" do %>
          <%= form.radio_button :place_kind, kind, checked: kind == (params.dig(:occasion, :place_kind) || "bar"), class: "sr-only" %> <%= kind.humanize %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="mb-6">
    <%= form.label :occurred_on, "Date", class: "field-label" %>
    <%= form.date_field :occurred_on, class: input_class(occasion, :occurred_on) %>
  </div>

  <fieldset class="mb-6">
    <legend class="field-label">Who came</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      <%= form.collection_check_boxes :person_ids, Current.logbook.people.order(:name), :id, :name do |b| %>
        <%= b.label(class: "chip") { b.check_box(class: "sr-only") + b.text } %>
      <% end %>
    </div>
  </fieldset>

  <div class="mb-6">
    <%= form.label :notes, class: "field-label" %>
    <%= form.text_area :notes, rows: 3, class: input_class(occasion, :notes) %>
  </div>

  <div class="actions mt-6">
    <%= form.submit class: "button-primary" %>
  </div>
<% end %>
