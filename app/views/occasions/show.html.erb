<% content_for :title, @occasion.title %>
<% place = @occasion.place %>

<div class="space-y-8">
  <%= link_to "← All occasions", occasions_path, class: "text-sm text-muted hover:text-cream" %>

  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <header class="flex flex-wrap items-start justify-between gap-6">
    <div class="min-w-0 flex-[999_1_28rem] space-y-3">
      <p class="eyebrow"><%= @occasion.occurred_on.strftime("%A, %B %-d, %Y") %></p>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="page-title"><%= link_to place.name, place, class: "text-cream hover:text-accent" %></h1>
        <span class="tag <%= "tag-home" if place.home? %>"><%= place.kind.humanize %></span>
      </div>
      <% if @occasion.people.any? %>
        <ul class="flex flex-wrap gap-2" aria-label="Who came">
          <% @occasion.people.sort_by(&:name).each do |person| %>
            <li><%= link_to person.name, person, class: "tag text-cream hover:text-accent" %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted">Nobody recorded.</p>
      <% end %>
      <% if @occasion.notes.present? %>
        <div class="max-w-2xl text-lg text-muted"><%= simple_format @occasion.notes %></div>
      <% end %>
    </div>
    <div class="actions">
      <%= link_to "Edit", edit_occasion_path(@occasion), class: "button-secondary" %>
      <%= button_to "Delete", @occasion, method: :delete, class: "button-tertiary", data: { turbo_confirm: "Delete this occasion and its drinks?" } %>
    </div>
  </header>

  <section class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="section-title">Drinks</h2>
      <div class="actions">
        <%= link_to "Log another drink", new_log_path(occasion_id: @occasion.id), class: "button-primary" %>
      </div>
    </div>
    <% if @occasion.tastings.any? %>
      <div class="card divide-y divide-line py-2">
        <% @occasion.tastings.each do |tasting| %>
          <%= render tasting, heading: link_to(tasting.drink.name, tasting.drink, class: "text-cream hover:text-accent"), actions: true %>
        <% end %>
      </div>
    <% else %>
      <p class="card text-muted">No drinks yet.</p>
    <% end %>
  </section>

  <section class="space-y-3">
    <h2 class="section-title">Photos</h2>
    <% if alert.present? %>
      <p class="flash-alert" id="alert"><%= alert %></p>
    <% end %>
    <div class="card space-y-5">
      <% if @occasion.photos.any? %>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          <% @occasion.photos.each do |photo| %>
            <div id="<%= dom_id photo %>" class="space-y-2">
              <div class="relative">
                <%= link_to photo.image.variant(:large), target: "_blank" do %>
                  <%= image_tag photo.image.variant(:thumb), alt: "Photo from #{@occasion.title}", class: "aspect-square w-full rounded-xl object-cover" %>
                <% end %>
                <% if photo.published? %>
                  <span class="tag absolute top-2 left-2 bg-lagoon-950/85">Public</span>
                <% end %>
              </div>
              <div class="actions">
                <% if photo.published? %>
                  <%= button_to "Unpublish", occasion_photo_path(@occasion, photo), method: :patch, params: { photo: { published: false } }, class: "button-secondary min-h-9 px-3 text-sm" %>
                <% elsif place.bar? && !demo? %>
                  <%= button_to "Publish", occasion_photo_path(@occasion, photo), method: :patch, params: { photo: { published: true } }, class: "button-secondary min-h-9 px-3 text-sm", data: { turbo_confirm: "Publish this photo on public pages? Only publish photos with no people in them." } %>
                <% end %>
                <%= button_to "Remove", occasion_photo_path(@occasion, photo), method: :delete, class: "button-tertiary min-h-9 px-3 text-sm", data: { turbo_confirm: "Remove this photo?" } %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if demo? %>
        <p class="text-sm text-muted">Photo uploads are turned off in the demo.</p>
      <% else %>
        <%= form_with url: occasion_photos_path(@occasion), class: "flex flex-wrap items-center gap-3" do |form| %>
          <%= form.file_field :photos, multiple: true, accept: PhotoAttachments::CONTENT_TYPES.join(","), aria: { label: "Photos" }, class: "input mt-0 w-auto grow" %>
          <div class="actions">
            <%= form.submit "Add photos", class: "button-secondary" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
