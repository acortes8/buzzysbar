<% content_for :title, "Places" %>

<div class="space-y-7">
  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Places</h1>
      <p class="mt-1 text-muted">Bars we've been to, and the homes we've made drinks in.</p>
    </div>
    <div class="actions">
      <%= link_to "New place", new_place_path, class: "button-secondary" %>
    </div>
  </div>

  <% if @places.any? %>
    <ul id="places" class="card divide-y divide-line p-0">
      <%= render @places %>
    </ul>
  <% else %>
    <p class="card text-center text-muted">No places yet. Logging a drink adds one.</p>
  <% end %>
</div>
