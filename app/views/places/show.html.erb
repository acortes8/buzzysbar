<% content_for :title, @place.name %>

<div class="mx-auto md:w-2/3 w-full bg-lagoon-800 p-5 rounded-lg">
  <% if notice.present? %>
    <p class="flash-notice mb-5" id="notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash-alert mb-5" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-accent text-4xl"><%= @place.name %></h1>
  <% if @place.published? %>
    <p class="mt-2 text-muted">Published: <%= link_to "see the public review", bar_path(@place), class: "underline" %></p>
  <% end %>

  <div><%= render @place %>

  <%= link_to "Edit this place", edit_place_path(@place), class: "button-primary" %>
  <%= link_to "Back to places", places_path, class: "button-secondary" %>
  <%= button_to "Destroy this place", @place, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "button-tertiary", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
