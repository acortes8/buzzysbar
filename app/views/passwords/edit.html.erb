<% content_for :title, "Update your password" %>

<div class="mx-auto max-w-md space-y-6">
  <% if alert = flash[:alert] %>
    <p class="flash-alert" id="alert"><%= alert %></p>
  <% end %>

  <div class="card space-y-6">
    <h1 class="page-title">Update your password</h1>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :password, "New password", class: "field-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Repeat it", class: "field-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>

      <div class="actions">
        <%= form.submit "Save", class: "button-primary" %>
      </div>
    <% end %>
  </div>
</div>
