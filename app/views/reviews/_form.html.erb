<%= form_with(model: review, class: "contents") do |form| %>
  <% if review.errors.any? %>
    <div id="error_explanation" class="error-explanation">
      <h2><%= pluralize(review.errors.count, "error") %> prohibited this review from being saved:</h2>
      <ul class="list-disc ml-6">
        <% review.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title %>
    <%= form.text_field :title, class: ["block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": review.errors[:title].none?, "border-red-400 focus:outline-red-600": review.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :body %>
    <%= form.text_area :body, rows: 5, class: ["block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": review.errors[:body].none?, "border-red-400 focus:outline-red-600": review.errors[:body].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :rating, "Rating (1–5)" %>
    <%= form.number_field :rating, in: 1..5, class: ["block shadow rounded-md border outline-none px-3 py-2 mt-2 w-24", {"border-gray-400 focus:outline-blue-600": review.errors[:rating].none?, "border-red-400 focus:outline-red-600": review.errors[:rating].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "button-primary" %>
  </div>
<% end %>
