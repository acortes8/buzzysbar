<% content_for :title, @review.title %>

<div class="mx-auto md:w-2/3 w-full bg-ablescent-white p-5 mb-5 rounded-lg">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-ablescent-white mb-5 text-elm font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="text-punch text-3xl font-bold mb-2"><%= @review.title %></h1>
  <p class="text-elm font-semibold mb-1">Rating: <%= @review.rating %> / 5</p>
  <p class="text-elm text-sm mb-6">By <%= @review.user.email_address %></p>
  <p class="text-elm leading-relaxed"><%= @review.body %></p>

  <div class="mt-8 flex gap-4">
    <%= link_to "Back to Reviews", reviews_path, class: "button-primary" %>
  </div>
</div>
