<% content_for :title, "Reviews" %>

<% if notice.present? %>
  <p class="notice" id="notice"><%= notice %></p>
<% end %>

<h1 class="text-punch text-3xl font-bold mb-6">Bar Reviews</h1>

<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @reviews.each do |review| %>
    <div class="bg-ablescent-white rounded-md shadow-lg hover:shadow-2xl transform hover:scale-[1.01] transition-transform duration-200 flex flex-col gap-3 p-5">
      <h2 class="text-punch text-xl font-bold"><%= review.title %></h2>
      <p class="text-elm text-sm font-semibold">Rating: <%= review.rating %> / 5</p>
      <p class="text-elm text-sm line-clamp-3"><%= review.body %></p>
      <div class="mt-auto">
        <%= link_to "Read more", review, class: "body-link" %>
      </div>
    </div>
  <% end %>
</section>

<div class="mt-8">
  <%= link_to "Write a Review", new_review_path, class: "button-primary" %>
</div>
