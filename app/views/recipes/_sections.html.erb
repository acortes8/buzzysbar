<%# A recipe's ingredients, instructions and description. Shared with the public cocktail page, so it shows only the recipe's own content. %>
<div class="space-y-6">
  <div class="grid gap-6 md:grid-cols-2">
    <section class="card">
      <h2 class="eyebrow mb-3">Ingredients</h2>
      <div class="prose prose-invert max-w-none text-cream"><%= recipe.ingredient_section %></div>
    </section>
    <section class="card">
      <h2 class="eyebrow mb-3">Instructions</h2>
      <div class="prose prose-invert max-w-none text-cream"><%= recipe.instruction_section %></div>
    </section>
  </div>

  <% if recipe.description.present? %>
    <section class="card">
      <h2 class="eyebrow mb-3">About this recipe</h2>
      <div class="prose prose-invert max-w-none text-cream"><%= recipe.description %></div>
    </section>
  <% end %>
</div>
