<% content_for :title, "Recipes" %>

<%= turbo_stream_from Current.logbook, :recipes %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="space-y-7">
  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Recipes</h1>
      <p class="mt-1 text-muted">How we make them, and where each one comes from.</p>
    </div>
    <div class="actions">
      <%= link_to "Books", books_path, class: "button-secondary" %>
      <%= link_to "New recipe", new_recipe_path, class: "button-primary" %>
    </div>
  </div>

  <% if @recipes.any? %>
    <div id="recipes" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <%= render @recipes %>
    </div>
  <% else %>
    <p class="card text-center text-muted">No recipes yet.</p>
  <% end %>
</div>
