<%= form_with(model: recipe, class: "contents") do |form| %>
  <% if recipe.errors.any? %>
    <div id="error_explanation" class="error-explanation">
      <h2><%= pluralize(recipe.errors.count, "error") %> prohibited this recipe from being saved:</h2>

      <ul class="list-disc ml-6">
        <% recipe.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :title, class: "field-label" %>
    <%= form.text_field :title, class: input_class(recipe, :title) %>
  </div>

  <div class="mb-6">
    <%= form.label :drink_name, "Drink", class: "field-label" %>
    <%= form.text_field :drink_name, list: "drink-names", placeholder: "e.g. Hurricane", class: input_class(recipe, :drink) %>
    <datalist id="drink-names">
      <% Current.logbook.drinks.order(:name).each do |drink| %>
        <option value="<%= drink.name %>"></option>
      <% end %>
    </datalist>
    <p class="hint">A new name adds the drink.</p>
  </div>

  <fieldset class="mb-6" data-controller="recipe-source">
    <%= form.label :source, "Where it's from", class: "field-label" %>
    <%= form.select :source, RecipesHelper::SOURCE_OPTIONS, {}, data: { recipe_source_target: "select", action: "recipe-source#toggle" }, class: input_class(recipe, :source) %>

    <div data-recipe-source-target="details" data-sources="book" class="flex flex-wrap gap-3">
      <div class="flex-1 min-w-48">
        <%= form.label :book_title, "Book", class: "field-label mt-3 block" %>
        <%= form.text_field :book_title, list: "book-titles", class: input_class(recipe, :book) %>
        <datalist id="book-titles">
          <% Current.logbook.books.order(:title).each do |book| %>
            <option value="<%= book.title %>"></option>
          <% end %>
        </datalist>
      </div>
      <div class="w-28">
        <%= form.label :page, class: "field-label mt-3 block" %>
        <%= form.number_field :page, min: 1, class: input_class(recipe, :page) %>
      </div>
    </div>

    <div data-recipe-source-target="details" data-sources="bartender bar">
      <%= form.label :credit, "Bartender or bar", class: "field-label mt-3 block" %>
      <%= form.text_field :credit, class: input_class(recipe, :credit) %>
    </div>
  </fieldset>

  <div class="mb-6">
    <%= form.label :based_on_id, "A riff on (optional)", class: "field-label" %>
    <%= form.collection_select :based_on_id, Current.logbook.recipes.where.not(id: recipe.id).order(:title), :id, :title, { include_blank: "Not a riff" }, class: input_class(recipe, :based_on) %>
  </div>

  <div class="mb-6">
    <%= form.label :featured_image, "Photo (optional)", class: "field-label" %>
    <% if demo? %>
      <p class="hint">Photo uploads are turned off in the demo.</p>
    <% else %>
      <%= form.file_field :featured_image, accept: PhotoAttachments::CONTENT_TYPES.join(","), class: input_class(recipe, :featured_image) %>
    <% end %>
  </div>

  <div class="mb-6">
    <%= form.label :ingredient_section, class: "field-label" %>
    <%= form.rich_textarea :ingredient_section, class: input_class(recipe, :ingredient_section, "prose prose-invert max-w-none") %>
  </div>

  <div class="mb-6">
    <%= form.label :instruction_section, class: "field-label" %>
    <%= form.rich_textarea :instruction_section, class: "input prose prose-invert max-w-none" %>
  </div>

  <div class="mb-6">
    <%= form.label :description, "Description (optional)", class: "field-label" %>
    <%= form.rich_textarea :description, class: "input prose prose-invert max-w-none" %>
  </div>

  <% unless demo? %>
    <div class="mb-6 flex items-start gap-2">
      <%= form.check_box :published %>
      <%= form.label :published, "Publish this recipe on public pages (not for recipes from books; its photo must show no people)", class: "field-label" %>
    </div>
  <% end %>

  <div class="actions">
    <%= form.submit class: "button-primary" %>
  </div>
<% end %>
