<% content_for :title, @recipe.title %>
<div class="mx-auto md:w-2/3 w-full bg-ablescent-white p-5 mb-5 rounded-lg">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-ablescent-white mb-5 text-elm font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <%= render @recipe %>

  <%= link_to "Back to recipes", recipes_path, class: "button-primary" %>
  <%= link_to "Edit this recipe", edit_recipe_path(@recipe), class: "button-secondary" %>
  <%= link_to "Destroy this recipe", @recipe, data: { turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "button-tertiary" %>
</div>
