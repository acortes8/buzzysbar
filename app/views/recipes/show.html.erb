<% content_for :title, @recipe.title %>

<div class="space-y-8">
  <%= link_to "← All recipes", recipes_path, class: "text-sm text-muted hover:text-cream" %>

  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <header id="<%= dom_id @recipe %>" class="flex flex-wrap items-start gap-8">
    <div class="min-w-0 flex-[999_1_28rem] space-y-4">
      <h1 class="page-title text-5xl"><%= @recipe.title %></h1>
      <ul class="flex flex-wrap gap-2">
        <li class="tag font-normal text-cream">A recipe for <%= link_to @recipe.drink.name, @recipe.drink, class: "underline" %></li>
        <li class="tag font-normal text-cream"><%= recipe_source(@recipe) || "Source not recorded" %></li>
        <% if @recipe.based_on %>
          <li class="tag font-normal text-cream">A riff on <%= link_to @recipe.based_on.title, @recipe.based_on, class: "underline" %></li>
        <% end %>
        <% if @recipe.published? %>
          <li class="tag tag-home font-normal">Published: <%= link_to "see the public page", cocktail_path(@recipe), class: "underline text-clay" %></li>
        <% end %>
      </ul>
      <div class="actions pt-2">
        <%= link_to "Edit", edit_recipe_path(@recipe), class: "button-secondary" %>
        <%= link_to "Make a riff", new_recipe_path(based_on_id: @recipe), class: "button-secondary" %>
        <%= button_to "Delete", @recipe, method: :delete, class: "button-tertiary", data: { turbo_confirm: "Delete this recipe?" } %>
      </div>
    </div>
    <% if @recipe.featured_image.attached? %>
      <%= link_to @recipe.featured_image.variant(:large), target: "_blank", class: "flex-[1_1_20rem]" do %>
        <%= image_tag @recipe.featured_image.variant(:large), alt: "Photo of #{@recipe.title}", class: "max-h-[26rem] w-full rounded-2xl object-cover" %>
      <% end %>
    <% end %>
  </header>

  <%= render "recipes/sections", recipe: @recipe %>

  <section class="space-y-3">
    <h2 class="section-title">Every time we've made it</h2>
    <% if @recipe.tastings.any? %>
      <div id="tastings" class="card divide-y divide-line py-2">
        <% @recipe.tastings.sort_by { |tasting| tasting.occasion.occurred_on }.reverse_each do |tasting| %>
          <%= render tasting, heading: link_to(tasting.occasion.title, tasting.occasion, class: "text-cream hover:text-accent") %>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted">No tastings use this recipe yet. Pick it under "Rate or edit" on a tasting.</p>
    <% end %>
  </section>

  <section class="space-y-3">
    <h2 class="section-title">Riffs</h2>
    <% if @recipe.riffs.any? %>
      <ul id="riffs" class="flex flex-wrap gap-2">
        <% @recipe.riffs.sort_by(&:title).each do |riff| %>
          <li><%= link_to riff.title, riff, class: "tag text-base text-cream hover:text-accent" %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted">No riffs on this one yet.</p>
    <% end %>
  </section>
</div>
