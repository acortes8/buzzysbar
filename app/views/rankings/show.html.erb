<% content_for :title, "#{@drink.name} ranking" %>

<div class="mx-auto md:w-2/3 w-full bg-ablescent-white p-5 rounded-lg">
  <h1 class="font-bold text-punch text-4xl"><%= @drink.name %></h1>
  <% if @drink.description.present? %>
    <div class="text-elm mt-2"><%= simple_format @drink.description %></div>
  <% end %>

  <ol id="ranking" class="divide-y divide-gray-200 mt-5">
    <% @drink.ranked_tastings.each do |tasting| %>
      <li id="<%= dom_id tasting %>" class="py-3 flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center gap-4">
          <% if (photo = tasting.public_photo) %>
            <%= link_to photo.variant(:large), target: "_blank", class: "shrink-0" do %>
              <%= image_tag photo.variant(:thumb), alt: "Photo of #{@drink.name}", class: "w-20 h-20 object-cover rounded-md shadow" %>
            <% end %>
          <% end %>
          <div>
            <%# Homes aren't named in public, since a home's name can identify someone. %>
            <% place = tasting.occasion.place %>
            <% if place.home? %>
              <span class="text-xl font-bold text-punch">At home</span>
            <% elsif place.published? %>
              <%= link_to place.name, bar_path(place), class: "text-xl font-bold text-punch hover:underline" %>
            <% else %>
              <span class="text-xl font-bold text-punch"><%= place.name %></span>
            <% end %>
            <span class="text-elm ml-2"><%= tasting.occasion.occurred_on.strftime("%B %Y") %></span>
          </div>
        </div>
        <span class="text-elm font-semibold">
          <% if tasting.average_score %>
            <%= format_score(tasting.average_score) %> / 5 from <%= pluralize(tasting.ratings.size, "rating") %>
          <% else %>
            Not rated
          <% end %>
        </span>
      </li>
    <% end %>
  </ol>

  <%= link_to "All rankings", rankings_path, class: "button-secondary mt-5" %>
</div>
