<% content_for :title, "Bars" %>

<div class="mx-auto max-w-4xl space-y-7">
  <div>
    <p class="eyebrow">Bar reviews</p>
    <h1 class="page-title mt-1">Bars</h1>
    <p class="mt-1 text-muted">Tiki bars we've been to, and what we thought.</p>
  </div>

  <% if @bars.any? %>
    <ul id="bars" class="card divide-y divide-line p-0">
      <% @bars.each do |bar| %>
        <li class="relative flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-6 py-4 hover:bg-lagoon-700/50">
          <%= link_to bar.name, bar_path(bar), class: "text-lg font-bold text-cream after:absolute after:inset-0 hover:text-accent" %>
          <span class="text-sm text-muted"><%= pluralize(bar.occasions.size, "visit") %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="card text-center text-muted">Nothing here yet.</p>
  <% end %>
</div>
