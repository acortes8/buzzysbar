<% content_for :title, "Log a drink" %>

<div class="mx-auto max-w-xl space-y-6">
  <h1 class="page-title">Log a drink</h1>

  <div class="card">

  <%= form_with(model: @log, url: log_path, class: "contents") do |form| %>
    <% if @log.errors.any? %>
      <div id="error_explanation" class="error-explanation">
        <h2><%= pluralize(@log.errors.count, "error") %> prohibited this drink from being logged:</h2>

        <ul class="list-disc ml-6">
          <% @log.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6">
      <%= form.label :drink_name, "Drink", class: "field-label" %>
      <%= form.text_field :drink_name, list: "drink-names", autocomplete: "off", autofocus: true, placeholder: "Mai Tai", class: input_class(@log, :drink_name, "text-lg py-3") %>
      <datalist id="drink-names">
        <% Current.logbook.drinks.order(:name).pluck(:name).each do |name| %>
          <option value="<%= name %>"></option>
        <% end %>
      </datalist>
    </div>

    <div class="mb-6">
      <%= form.label :place_name, "Where", class: "field-label" %>
      <%= form.text_field :place_name, list: "place-names", autocomplete: "off", placeholder: "Bar name, or Home", class: input_class(@log, :place_name, "text-lg py-3") %>
      <datalist id="place-names">
        <% Current.logbook.places.order(:name).pluck(:name).each do |name| %>
          <option value="<%= name %>"></option>
        <% end %>
      </datalist>
      <p class="hint">A new name adds a new bar.</p>
    </div>

    <details class="mb-6" <%= "open" if @log.errors.any? %>>
      <summary class="flex min-h-11 cursor-pointer items-center font-medium text-muted hover:text-cream">Date, who came, notes, photo</summary>

      <div class="mb-6">
        <%= form.label :occurred_on, "Date", class: "field-label" %>
        <%= form.date_field :occurred_on, class: "input" %>
      </div>

      <fieldset class="mb-6">
        <legend class="field-label">Who came</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          <%= form.collection_check_boxes :person_ids, Current.logbook.people.order(:name), :id, :name do |b| %>
            <%= b.label(class: "chip") { b.check_box(class: "sr-only") + b.text } %>
          <% end %>
        </div>
      </fieldset>

      <div class="mb-6">
        <%= form.label :other_people, "Anyone else", class: "field-label" %>
        <%= form.text_field :other_people, placeholder: "Names, separated by commas", class: "input" %>
      </div>

      <div class="mb-6">
        <%= form.label :notes, class: "field-label" %>
        <%= form.text_area :notes, rows: 2, class: "input" %>
      </div>

      <div class="mb-6">
        <%= form.label :photo, class: "field-label" %>
        <% if demo? %>
          <p class="hint">Photo uploads are turned off in the demo.</p>
        <% else %>
          <%= form.file_field :photo, accept: PhotoAttachments::CONTENT_TYPES.join(","), class: "input" %>
        <% end %>
      </div>
    </details>

    <div class="actions">
      <%= form.submit "Log it", class: "button-primary min-h-14 w-full text-lg sm:w-full" %>
    </div>
    <p class="hint text-center">Ratings can wait until later.</p>
  <% end %>
  </div>
</div>
