<% content_for :title, "Users" %>

<div class="space-y-7">
  <%= link_to "← People", people_path, class: "text-sm text-muted hover:text-cream" %>

  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">Users</h1>
      <p class="mt-1 text-muted">Accounts that can sign in to this logbook. There's no public sign-up.</p>
    </div>
    <% unless demo? %>
      <div class="actions">
        <%= link_to "New user", new_user_path, class: "button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @users.any? %>
    <ul id="users" class="card divide-y divide-line p-0">
      <%= render @users %>
    </ul>
  <% else %>
    <p class="card text-center text-muted">No users yet.</p>
  <% end %>
</div>
