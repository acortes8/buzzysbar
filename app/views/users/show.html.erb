<% content_for :title, @user.name %>

<div class="space-y-8">
  <%= link_to "← All users", users_path, class: "text-sm text-muted hover:text-cream" %>

  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <header class="flex flex-wrap items-start justify-between gap-6">
    <div class="space-y-2">
      <p class="eyebrow">Account</p>
      <h1 class="page-title text-5xl"><%= @user.name %></h1>
      <p class="text-muted"><%= @user.email_address %></p>
      <% if @user.person %>
        <p class="text-muted">Logs drinks as <%= link_to @user.person.name, @user.person, class: "underline" %></p>
      <% end %>
    </div>
    <% unless demo? %>
      <div class="actions">
        <%= link_to "Edit", edit_user_path(@user), class: "button-secondary" %>
        <%= button_to "Delete", @user, method: :delete, class: "button-tertiary", data: { turbo_confirm: "Delete this user?" } %>
      </div>
    <% end %>
  </header>
</div>
