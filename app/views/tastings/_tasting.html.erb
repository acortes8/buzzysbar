<%# Pass heading: to choose what the tasting is titled by, e.g. the drink on an occasion page or the occasion on a drink page. %>
<div id="<%= dom_id tasting %>" class="flex gap-4 py-4">
  <% if tasting.photo.attached? %>
    <%= link_to tasting.photo.variant(:large), target: "_blank", class: "shrink-0" do %>
      <%= image_tag tasting.photo.variant(:thumb), alt: "Photo of #{tasting.drink.name}", class: "size-20 rounded-xl object-cover sm:size-24" %>
      <% if tasting.photo_published? %>
        <span class="mt-1 block text-center text-xs text-muted">Public</span>
      <% end %>
    <% end %>
  <% end %>

  <div class="min-w-0 flex-1 space-y-1.5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <h3 class="text-xl font-bold"><%= heading %></h3>
      <% if tasting.average_score %>
        <span class="score">Average <%= format_score(tasting.average_score) %> / 5</span>
      <% end %>
    </div>

    <% if tasting.recipe %>
      <p class="text-sm text-muted">Made with <%= link_to tasting.recipe.title, tasting.recipe, class: "underline" %></p>
    <% end %>

    <% if tasting.notes.present? %>
      <p class="text-muted"><%= tasting.notes %></p>
    <% end %>

    <% if tasting.ratings.any? %>
      <ul class="space-y-1">
        <% tasting.ratings.sort_by { |rating| rating.person.name }.each do |rating| %>
          <li>
            <span class="font-medium"><%= rating.person.name %></span>
            <span class="score ml-1"><%= format_score(rating.score) %></span>
            <% if rating.notes.present? %><span class="text-muted"> · <%= rating.notes %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if local_assigns[:actions] %>
      <div class="actions pt-2">
        <%= link_to "Rate or edit", edit_occasion_tasting_path(tasting.occasion, tasting), class: "button-secondary min-h-9 px-4 text-sm" %>
        <%= button_to "Remove", occasion_tasting_path(tasting.occasion, tasting), method: :delete, class: "button-tertiary min-h-9 px-4 text-sm", data: { turbo_confirm: "Remove this drink and its ratings?" } %>
      </div>
    <% end %>
  </div>
</div>
