<% content_for :title, @person.name %>

<div class="space-y-8">
  <%= link_to "← All people", people_path, class: "text-sm text-muted hover:text-cream" %>

  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash-alert" id="alert"><%= alert %></p>
  <% end %>

  <header class="flex flex-wrap items-start justify-between gap-6">
    <div class="space-y-2">
      <h1 class="page-title text-5xl"><%= @person.name %></h1>
      <p class="text-muted"><%= @person.user ? "Account: #{@person.user.name}" : "No account" %></p>
    </div>
    <div class="actions">
      <%= link_to "Edit", edit_person_path(@person), class: "button-secondary" %>
      <%= button_to "Delete", @person, method: :delete, class: "button-tertiary", data: { turbo_confirm: "Delete this person?" } %>
    </div>
  </header>

  <section class="space-y-3">
    <h2 class="section-title">Occasions</h2>
    <% occasions = @person.occasions.includes(:place).order(occurred_on: :desc) %>
    <% if occasions.any? %>
      <ul class="card divide-y divide-line p-0">
        <% occasions.each do |occasion| %>
          <li class="relative flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-6 py-4 hover:bg-lagoon-700/50">
            <%= link_to occasion.place.name, occasion, class: "font-semibold text-cream after:absolute after:inset-0 hover:text-accent" %>
            <span class="text-sm text-muted"><%= occasion.occurred_on.to_fs(:long_ordinal) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted">Not at any occasions yet.</p>
    <% end %>
  </section>
</div>
