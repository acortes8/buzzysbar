<%= form_with(model: person, class: "contents") do |form| %>
  <% if person.errors.any? %>
    <div id="error_explanation" class="error-explanation">
      <h2><%= pluralize(person.errors.count, "error") %> prohibited this person from being saved:</h2>

      <ul class="list-disc ml-6">
        <% person.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :name, class: "field-label" %>
    <%= form.text_field :name, class: input_class(person, :name) %>
  </div>

  <div class="mb-6">
    <%= form.label :user_id, "Account", class: "field-label" %>
    <%= form.collection_select :user_id, Current.logbook.users.order(:name), :id, :name, { include_blank: "No account" }, class: input_class(person, :user_id) %>
  </div>

  <div class="actions">
    <%= form.submit class: "button-primary" %>
  </div>
<% end %>
