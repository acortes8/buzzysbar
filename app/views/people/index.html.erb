<% content_for :title, "People" %>

<div class="space-y-7">
  <% if notice.present? %>
    <p class="flash-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="page-title">People</h1>
      <p class="mt-1 text-muted">Everyone who's come along, with or without an account.</p>
    </div>
    <div class="actions">
      <%= link_to "Accounts", users_path, class: "button-secondary" %>
      <%= link_to "New person", new_person_path, class: "button-secondary" %>
    </div>
  </div>

  <% if @people.any? %>
    <ul id="people" class="card divide-y divide-line p-0">
      <%= render @people %>
    </ul>
  <% else %>
    <p class="card text-center text-muted">No people yet.</p>
  <% end %>
</div>
