<%# A person's row on the people list. %>
<li id="<%= dom_id person %>" class="relative flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-6 py-4 hover:bg-lagoon-700/50">
  <%# The link covers the whole row. %>
  <%= link_to person.name, person, class: "text-lg font-bold text-cream after:absolute after:inset-0 hover:text-accent" %>
  <span class="text-sm text-muted"><%= person.user ? "Account: #{person.user.name}" : "No account" %></span>
</li>
