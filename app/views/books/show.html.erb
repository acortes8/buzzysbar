<% content_for :title, @book.title %>

<div class="mx-auto md:w-2/3 w-full bg-ablescent-white p-5 rounded-lg">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-ablescent-white mb-5 text-elm font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-punch text-4xl"><%= @book.title %></h1>
  <% if @book.author.present? %>
    <p class="text-elm mt-2">by <%= @book.author %></p>
  <% end %>
  <p class="text-elm mt-2">Recipes from books stay private.</p>

  <ul id="recipes" class="divide-y divide-gray-200 my-5">
    <% @book.recipes.includes(:drink).sort_by { |recipe| [ recipe.page || Float::INFINITY, recipe.title ] }.each do |recipe| %>
      <li class="py-3 flex justify-between items-baseline gap-2">
        <%= link_to recipe.title, recipe, class: "text-xl font-bold text-punch hover:underline" %>
        <% if recipe.page %><span class="text-elm">page <%= recipe.page %></span><% end %>
      </li>
    <% end %>
  </ul>

  <%= link_to "Edit this book", edit_book_path(@book), class: "button-primary" %>
  <%= link_to "Back to books", books_path, class: "button-secondary" %>
  <%= button_to "Destroy this book", @book, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "button-tertiary", data: { turbo_confirm: "Are you sure?" } %>
</div>
