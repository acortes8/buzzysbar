<% content_for :title, @recipe.title %>

<div class="space-y-8">
  <%= link_to "← All cocktails", cocktails_path, class: "text-sm text-muted hover:text-cream" %>

  <header class="flex flex-wrap items-start gap-8">
    <div class="min-w-0 flex-[999_1_28rem] space-y-4">
      <p class="eyebrow">Cocktail</p>
      <h1 class="page-title text-5xl"><%= @recipe.title %></h1>
      <ul class="flex flex-wrap gap-2">
        <li class="tag font-normal text-cream">
          A recipe for
          <% if @recipe.drink.published? %>
            <%= link_to @recipe.drink.name, ranking_path(@recipe.drink), class: "underline" %>
          <% else %>
            <%= @recipe.drink.name %>
          <% end %>
        </li>
        <li class="tag font-normal text-cream"><%= recipe_source(@recipe) %></li>
        <%# Only published originals and riffs are named, since a private recipe's title could name someone. %>
        <% if (original = Recipe.published.find_by(id: @recipe.based_on_id)) %>
          <li class="tag font-normal text-cream">A riff on <%= link_to original.title, cocktail_path(original), class: "underline" %></li>
        <% end %>
      </ul>
    </div>
    <% if @recipe.featured_image.attached? %>
      <%= image_tag @recipe.featured_image.variant(:large), alt: @recipe.title, class: "max-h-[26rem] flex-[1_1_20rem] rounded-2xl object-cover" %>
    <% end %>
  </header>

  <%= render "recipes/sections", recipe: @recipe %>

  <% if (riffs = @recipe.riffs.published.order(:title)).any? %>
    <section class="space-y-3">
      <h2 class="section-title">Riffs</h2>
      <ul id="riffs" class="flex flex-wrap gap-2">
        <% riffs.each do |riff| %>
          <li><%= link_to riff.title, cocktail_path(riff), class: "tag text-base text-cream hover:text-accent" %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
