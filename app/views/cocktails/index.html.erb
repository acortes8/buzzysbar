<% content_for :title, "Cocktails" %>

<div class="space-y-7">
  <div>
    <p class="eyebrow">Recipes</p>
    <h1 class="page-title mt-1">Cocktails</h1>
    <p class="mt-1 text-muted">Recipes of our own, and ones bartenders shared with us.</p>
  </div>

  <% if @recipes.any? %>
    <div id="cocktails" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @recipes.each do |recipe| %>
        <article class="card relative flex flex-col gap-2 overflow-hidden p-0 hover:border-line-strong">
          <% if recipe.featured_image.attached? %>
            <%= image_tag recipe.featured_image.variant(:thumb), alt: "", class: "aspect-[4/3] w-full object-cover" %>
          <% else %>
            <div class="flex aspect-[4/3] w-full items-center justify-center bg-lagoon-700 font-logo text-4xl text-line-strong" aria-hidden="true"><%= recipe.drink.name.first %></div>
          <% end %>
          <div class="px-5 pt-1 pb-5">
            <h2 class="text-lg leading-snug font-bold">
              <%= link_to recipe.title, cocktail_path(recipe), class: "text-cream after:absolute after:inset-0 hover:text-accent" %>
            </h2>
            <p class="mt-1 text-sm text-muted"><%= recipe_source(recipe) %></p>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="card text-center text-muted">Nothing here yet.</p>
  <% end %>
</div>
